{
    "files.associations": {
        "*.md": "markdown"
    },
    "markdown.preview.breaks": true,
    "markdown.preview.typographer": true,
    "markdownlint.config": {
        "MD013": false,
        "MD033": false,
        "MD041": false
    },
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "foam.files.ignore": [
        "**/node_modules/**",
        "**/.git/**"
    ]
}