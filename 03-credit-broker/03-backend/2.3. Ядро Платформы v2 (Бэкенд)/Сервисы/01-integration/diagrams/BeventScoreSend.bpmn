параметры заявки:
статус,
date_send,
bank_app_id = Opty_Id (из ответа CreateOpty_spcv2)
insurance_amount (из modifyAppOnSuccessSend)</bpmn:text></bpmn:textAnnotation><bpmn:group id="Group_0fuo7w5" categoryValueRef="CategoryValue_1tdi0s6" /><bpmn:textAnnotation id="TextAnnotation_05moj5v"><bpmn:text>"{Тип анкеты} заявка ушла на скоринг"</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TextAnnotation_0iv79kd"><bpmn:text>Код банка НЕ входит в список:
DCMTS  
DCPAY  
DCPAY_CASH  KVIKU  
MPAY  
MTS  
OTP  
PORUBLYU  
REN  
REVO</bpmn:text></bpmn:textAnnotation><bpmn:group id="Group_0etr8yv" categoryValueRef="CategoryValue_16h6ztm" /><bpmn:group id="Group_1brj8ki" categoryValueRef="CategoryValue_0q6vt67" /><bpmn:textAnnotation id="TextAnnotation_0mmks68"><bpmn:text>insurance_amount =
страхование жизни (из calcMonthlyPaymentParamsByApp) + страхование от несчастных случаев / работы (из calcMonthlyPaymentParamsByApp)
(сумму окрулить до копеек)</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_1r041oa" associationDirection="None" sourceRef="Activity_1hkj2ke" targetRef="TextAnnotation_0ipkdes" /><bpmn:association id="Association_1kne0b9" associationDirection="None" sourceRef="Activity_1bjdzuy" targetRef="TextAnnotation_05moj5v" /><bpmn:association id="Association_0so6lev" associationDirection="None" sourceRef="Gateway_0mtc5yq" targetRef="TextAnnotation_0iv79kd" /><bpmn:association id="Association_060clo7" associationDirection="None" sourceRef="Activity_02vabgj" targetRef="TextAnnotation_0mmks68" /></bpmn:collaboration><bpmn:process id="BeventScoreSend" isExecutable="true"><bpmn:laneSet id="LaneSet_1nv61v7"><bpmn:lane id="Lane_1gvp0wy" name="Брокер"><bpmn:flowNodeRef>Gateway_1o4fxz0</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_13zwsjr</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_0thvtvh</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_1kl7wfa</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_13dih16</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_1hkj2ke</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_1bjdzuy</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_0mtc5yq</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_0s3x8bi</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_0dvr27l</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_1u69uog</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_1ojfy1v</bpmn:flowNodeRef><bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_16cbp3p</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_12uvpb6</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_02vabgj</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:exclusiveGateway id="Gateway_1o4fxz0"><bpmn:incoming>Flow_161jold</bpmn:incoming><bpmn:incoming>Flow_1reho0t</bpmn:incoming><bpmn:outgoing>Flow_0oosd9s</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Activity_13zwsjr" name="Установить статус заказа 7 (Отправлен на рассмотрение)"><bpmn:incoming>Flow_02p3k1e</bpmn:incoming><bpmn:outgoing>Flow_161jold</bpmn:outg